<div class="modal" id="rateModal"><div class="modal-card">
  <h3>How is your order?</h3><p style="color:var(--muted)">Tap a star to rate</p>
  <div class="big-stars" id="rateStars"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
  <textarea class="input" id="rateText" placeholder="Add detailed review..." style="margin:12px 0"></textarea>
  <div style="display:flex;gap:10px"><button class="btn" id="rateCancel" style="flex:1;justify-content:center">Cancel</button><button class="btn primary" id="rateSubmit" style="flex:1;justify-content:center">Submit</button></div>
</div></div>
<script>
(function(){
  const m=document.getElementById('rateModal'); if(!m) return;
  window.openRateModal=function(){m.classList.add('open')};
  document.getElementById('rateCancel')?.addEventListener('click',()=>m.classList.remove('open'));
  document.getElementById('rateSubmit')?.addEventListener('click',()=>{m.classList.remove('open'); if(window.toast) toast('Thanks for your review! ★★★★★')});
  document.querySelectorAll('#rateStars span').forEach((s,i,arr)=>s.addEventListener('click',()=>{arr.forEach((x,j)=>x.style.color=j<=i?'#F59E0B':'#DDD')}));
})();
</script>


